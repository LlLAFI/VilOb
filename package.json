{
  "name": "village-observer",
  "version": "0.35.0-h1b1a",
  "private": true,
  "description": "Village Observer static dual-build source foundation",
  "scripts": {
    "build": "node tools/build.mjs",
    "check:source": "node tools/build.mjs --check-only",
    "test:static": "node tools/run-static-tests.cjs",
    "test": "node tools/build.mjs --check-only && npm run test:static",
    "test:35g1a": "node tests/test-35g1a.cjs",
    "test:35g1b": "node tests/test-35g1b.cjs",
    "test:35h0": "node tests/test-35h0.cjs",
    "test:35h1a": "node tests/test-35h1a.cjs && node tests/test-35h1a-parity.cjs",
    "test:35h1a-hf": "node tests/test-35h1a-hf.cjs && node tests/test-35h1a.cjs && node tests/test-35h1a-parity.cjs",
    "prune:preview": "node tools/prune-archive.mjs",
    "prune:apply": "node tools/prune-archive.mjs --apply"
  },
  "engines": {
    "node": ">=18"
  }
}
